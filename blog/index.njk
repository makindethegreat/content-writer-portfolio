---
permalink: blog/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Research, comparisons and practical perspectives on content strategy, B2B SaaS and search discoverability from Vevnit.">
  <meta name="theme-color" content="#F3EFE0">
  <title>Blog — Vevnit</title>
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
  <style>
    .blog-archive{background:#F3EFE0;color:#1F2224;min-height:70vh;padding:clamp(72px,10vw,144px) max(6vw,24px) clamp(88px,12vw,160px)}
    .blog-archive-inner{max-width:1240px;margin:0 auto}
    .blog-archive-kicker{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8A6A59;margin:0 0 22px}
    .blog-archive h1{font-size:clamp(48px,8vw,104px);line-height:.98;letter-spacing:-.065em;font-weight:400;max-width:850px;margin:0}
    .blog-archive-intro{font-size:clamp(16px,1.6vw,20px);line-height:1.65;color:#5D5A53;max-width:570px;margin:28px 0 76px}
    .blog-archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:48px;row-gap:64px}
    .blog-archive-card{min-width:0}
    .blog-archive-card a{color:inherit;text-decoration:none;display:block}
    .blog-archive-card a:focus-visible{outline:2px solid #C95F3C;outline-offset:7px}
    .blog-card-image{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;margin:0 0 24px;background:#E7DFCE}
    .blog-card-meta{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:18px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#777168}
    .blog-card-category{color:#A34F35}
    .blog-card-title{font-size:clamp(24px,2.4vw,34px);line-height:1.12;letter-spacing:-.04em;font-weight:400;margin:0 0 16px;max-width:440px}
    .blog-card-excerpt{font-size:15px;line-height:1.75;color:#625F58;margin:0;max-width:440px}
    .blog-card-read{display:inline-block;margin-top:25px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#1F2224}
    .blog-archive-card a:hover .blog-card-title{color:#A34F35}
    @media(max-width:900px){.blog-archive-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:52px 36px}.blog-archive-intro{margin-bottom:58px}}
    @media(max-width:600px){.blog-archive{padding:76px 24px 96px}.blog-archive-grid{grid-template-columns:1fr;gap:46px}.blog-archive-intro{margin:22px 0 48px}.blog-card-title{font-size:29px}}
  </style>
</head>
<body class="blog-archive-page">
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="brand-lockup" href="{{ '/' | url }}" aria-label="Vevnit home"><span class="brand-wordmark">vevnit<span>.</span></span></a>
      <a class="mobile-nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
      <ul id="primary-menu">
        <li><a href="{{ '/about.html' | url }}">About</a></li>
        <li><a href="{{ '/blog/' | url }}" aria-current="page">Blog</a></li>
        <li><a href="{{ '/case-studies.html' | url }}">Work</a></li>
        <li><a class="nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a></li>
      </ul>
    </nav>
  </header>
  <main class="blog-archive">
    <div class="blog-archive-inner">
      <p class="blog-archive-kicker">VEVNIT / NOTES &amp; ANALYSIS</p>
      <h1>Ideas, examined.</h1>
      <p class="blog-archive-intro">Research, comparisons and practical perspectives on building a more deliberate content practice for B2B SaaS.</p>
      <section class="blog-archive-grid" aria-label="Blog posts">
        <article class="blog-archive-card">
          <a href="{{ '/blog/leadbay-vs-leadloft/' | url }}">
            <img class="blog-card-image" src="{{ '/assets/images/leadbay-vs-leadloft-cover.webp' | url }}" alt="Leadbay vs. Leadloft comparison cover artwork for Vevnit" width="768" height="402" fetchpriority="high">
            <div class="blog-card-meta"><span class="blog-card-category">Tool comparison</span><time datetime="2026-10">October 2026</time><span>12 min read</span></div>
            <h2 class="blog-card-title">Leadbay vs. Leadloft: Which Tool Is Right for Your Team?</h2>
            <p class="blog-card-excerpt">A closer look at two prospecting platforms, their approaches to lead discovery, and the differences that matter when choosing a tool for your sales workflow.</p>
            <span class="blog-card-read">Read the article ↗</span>
          </a>
        </article>
        {% for post in collections.publishedPosts %}
        <article class="blog-archive-card">
          <a href="{{ post.url | url }}">
            {% if post.data.featuredImage %}<img class="blog-card-image" src="{{ post.data.featuredImage | url }}" alt="{{ post.data.title }} featured image" loading="lazy">{% endif %}
            <div class="blog-card-meta"><span class="blog-card-category">{{ post.data.category or "Article" }}</span><time datetime="{{ post.data.date | date: '%Y-%m-%d' }}">{{ post.data.date | date: "%B %Y" }}</time></div>
            <h2 class="blog-card-title">{{ post.data.title }}</h2>
            <p class="blog-card-excerpt">{{ post.data.excerpt }}</p>
            <span class="blog-card-read">Read the article ↗</span>
          </a>
        </article>
        {% endfor %}
      </section>
    </div>
  </main>
  <script src="{{ '/script.js' | url }}"></script>
</body>
</html>
