<body class="blog-archive-page">
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="brand-lockup" href="{{ '/' | url }}" aria-label="Vevnit home"><span class="brand-wordmark">vevnit<span>.</span></span></a>
      <a class="mobile-nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
      <ul id="primary-menu">
        <li><a href="/about/">About</a></li>
        <li><a href="/blog/" aria-current="page">Blog</a></li>
        <li><a href="/#portfolio">Work</a></li>
        <li><a class="nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a></li>
      </ul>
    </nav>
  </header>
  <main class="blog-archive">
    <div class="blog-archive-inner">
      <p class="blog-archive-kicker">VEVNIT / BLOG</p>
      <h1>Ideas, Strategy, Deep Dives.</h1>
      <p class="blog-archive-intro">Research, teardowns and practical perspectives on building a more deliberate content practice for B2B SaaS.</p>
      <section class="blog-archive-grid" aria-label="Blog posts">
        <article class="blog-archive-card">
          <a href="/blog/leadbay-vs-leadloft/" aria-label="Read Leadbay vs. Leadloft on Vevnit">
            <img class="blog-card-image" src="/assets/images/leadbay-vs-leadloft-cover.webp" alt="Leadbay vs. Leadloft comparison cover artwork for Vevnit" width="768" height="402" fetchpriority="high">
            <div class="blog-card-meta"><span class="blog-card-category">Tool comparison</span><time datetime="2026-10">October 2026</time><span>12 min read</span></div>
            <h2 class="blog-card-title">Leadbay vs. Leadloft: Which Tool Is Right for Your Team?</h2>
            <p class="blog-card-excerpt">A closer look at two prospecting platforms, their approaches to lead discovery, and the differences that matter when choosing a tool for your sales workflow.</p>
            <span class="blog-card-read">Read the article ↗</span>
          </a>
        </article>
        {% for post in collections.publishedPosts %}
        <article class="blog-archive-card">
          <a href="{{ post.url | url }}">
            {% if post.data.featuredImage %}<img class="blog-card-image" src="{{ post.data.featuredImage | url }}" alt="{{ post.data.title }} featured image" loading="lazy">{% endif %}
            <div class="blog-card-meta"><span class="blog-card-category">{{ post.data.category or "Article" }}</span><time datetime="{{ post.data.date | date("%Y-%m-%d") }}">{{ post.data.date | date("%B %Y") }}</time></div>
            <h2 class="blog-card-title">{{ post.data.title }}</h2>
            <p class="blog-card-excerpt">{{ post.data.excerpt }}</p>
            <span class="blog-card-read">Read the article ↗</span>
          </a>
        </article>
        {% endfor %}
      </section>
    </div>
  </main>
  <script src="/script.js?v=blog-archive-20261031"></script>
