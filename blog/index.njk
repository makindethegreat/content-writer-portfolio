    .blog-archive-kicker{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8A6A59;margin:0 0 22px}
    .blog-archive h1{font-size:clamp(48px,8vw,104px);line-height:.98;letter-spacing:-.065em;font-weight:400;max-width:850px;margin:0}
    .blog-archive-intro{font-size:clamp(16px,1.6vw,20px);line-height:1.65;color:#5D5A53;max-width:570px;margin:28px 0 76px}
    .blog-archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:48px;row-gap:64px}
    .blog-archive-card{min-width:0}
    .blog-archive-card a{color:inherit;text-decoration:none;display:block}
    .blog-archive-card a:focus-visible{outline:2px solid #C95F3C;outline-offset:7px}
