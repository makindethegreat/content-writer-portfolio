      .blog-archive-page .site-nav ul{gap:15px;flex-wrap:wrap;justify-content:flex-end}
      .blog-archive-page .site-nav ul li a{font-size:.78rem;white-space:nowrap}
      .blog-archive-page .site-nav ul li:last-child{position:static}
      .blog-archive-page .site-nav a.nav-cta{padding:7px 10px!important;font-size:.75rem!important}
    }
    .blog-archive{background:#F3EFE0;color:#1F2224;min-height:70vh;padding:clamp(72px,10vw,144px) max(6vw,24px) clamp(88px,12vw,160px)}
