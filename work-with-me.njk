    <!-- 3D Flip Card Interactive Controller -->
    <script>
      (function () {
        const scenes = document.querySelectorAll('.flip-card-scene');

        scenes.forEach((scene) => {
          const inner = scene.querySelector('.flip-card-inner');
          const frontFace = scene.querySelector('.flip-card-front');
          const returnTriggers = scene.querySelectorAll('.flip-return-btn, .flip-return-pill');

          if (frontFace) {
            frontFace.addEventListener('click', () => {
              inner.classList.add('is-flipped');
            });
          }

          returnTriggers.forEach((btn) => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              inner.classList.remove('is-flipped');
            });
          });
        });
      })();
    </script>
    <script src="/script.js" defer></script>
