  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seoTitle or title }} | Vevnit</title>
  <meta name="description" content="{{ seoDescription or excerpt }}">
  <meta name="theme-color" content="#F3EFE0">\n  <meta property="og:type" content="article">\n  <meta property="og:title" content="{{ seoTitle or title }}">\n  <meta property="og:description" content="{{ seoDescription or excerpt }}">\n  {% if featuredImage %}<meta property="og:image" content="{{ featuredImage }}">{% endif %}
  <link rel="canonical" href="{{ canonicalUrl or ('https://vevnit.com' + page.url) }}">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v=blog-archive-20261031">
  <style>
    /*
     * Article-only editorial system.
     * Keep these selectors scoped to the post layout so shared site chrome
     * and all non-blog routes retain their existing presentation.
     */
    .cms-article {
      --article-ink: #1F2224;
      --article-muted: #625F58;
      --article-rule: #D7CEBC;
      --article-accent: #A34F35;
      background: #F3EFE0;
      color: var(--article-ink);
      min-height: 80vh;
      padding: clamp(42px, 6vw, 76px) clamp(20px, 5vw, 40px) 96px;
    }

    .cms-article-inner {
      width: min(100%, 880px);
      margin: 0 auto;
    }

    .cms-breadcrumb {
      max-width: 760px;
      margin: 0 auto clamp(30px, 4vw, 44px);
      color: #777168;
      font-size: 11px;
      line-height: 1.5;
      letter-spacing: .07em;
      text-transform: uppercase;
    }

    .cms-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .cms-breadcrumb a:hover,
    .cms-article-footer a:hover {
      color: var(--article-accent);
    }

    .cms-article-meta {
      display: flex;
      align-items: center;
      gap: 10px 16px;
      flex-wrap: wrap;
      max-width: 760px;
      margin: 0 auto 16px;
      color: #8A6A59;
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .cms-article h1 {
      max-width: 760px;
      margin: 0 auto 18px;
      color: var(--article-ink);
      font-size: clamp(2rem, 4.2vw, 3.65rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -.045em;
      text-wrap: balance;
    }

    .cms-article-excerpt {
      max-width: 700px;
      margin: 0 auto 30px;
      color: var(--article-muted);
      font-size: clamp(1rem, 1.5vw, 1.2rem);
      font-weight: 400;
      line-height: 1.65;
    }

    .cms-featured-image {
      display: block;
      width: min(100%, 820px);
      max-height: 430px;
      aspect-ratio: 16 / 9;
      margin: 0 auto clamp(38px, 5vw, 54px);
      object-fit: cover;
      object-position: center;
      background: #E7DFCE;
      border-radius: 2px;
    }

    .cms-prose {
      width: 100%;
      max-width: 700px;
      margin: 0 auto;
      color: #343936;
      font-size: clamp(1rem, 1.15vw, 1.075rem);
      line-height: 1.82;
      overflow-wrap: break-word;
    }

    .cms-prose > :first-child {
      margin-top: 0;
    }

    .cms-prose h2 {
      margin: 2.25em 0 .65em;
      color: var(--article-ink);
      font-size: clamp(1.55rem, 2.7vw, 2rem);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -.025em;
      text-wrap: balance;
    }

    .cms-prose h3 {
      margin: 1.8em 0 .55em;
      color: var(--article-ink);
      font-size: clamp(1.2rem, 2vw, 1.45rem);
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -.015em;
    }

    .cms-prose h4 {
      margin: 1.5em 0 .5em;
      color: var(--article-ink);
      font-size: 1.1rem;
      font-weight: 500;
      line-height: 1.35;
    }

    .cms-prose p,
    .cms-prose ul,
    .cms-prose ol {
      margin: 0 0 1.25em;
    }

    .cms-prose ul,
    .cms-prose ol {
      padding-left: 1.4em;
    }

    .cms-prose li {
      padding-left: .2em;
      margin: .35em 0;
    }

    .cms-prose a {
      color: var(--article-accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .cms-prose img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    .cms-prose blockquote {
      margin: 2em 0;
      padding: .15em 0 .15em 22px;
      border-left: 2px solid #C95F3C;
      color: var(--article-muted);
    }

    .cms-prose blockquote > :last-child {
      margin-bottom: 0;
    }

    .cms-table-wrap {
      width: 100%;
      margin: 2em 0;
      overflow-x: auto;
      border: 1px solid var(--article-rule);
    }

    .cms-prose table {
      display: table;
      width: 100%;
      min-width: 560px;
      border-collapse: collapse;
      overflow: visible;
      font-size: .9em;
    }

    .cms-prose caption {
      padding: 12px;
      text-align: left;
      font-weight: 500;
    }

    .cms-prose th {
      background: #E7DFCE;
      color: var(--article-ink);
      font-weight: 500;
    }

    .cms-prose th,
    .cms-prose td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--article-rule);
      text-align: left;
      vertical-align: top;
    }

    .cms-prose tbody tr:last-child td {
      border-bottom: 0;
    }

    .cms-inline-image,
    .cms-embed {
      margin: 2em 0;
    }

    .cms-inline-image figcaption,
    .cms-embed figcaption {
      margin-top: 9px;
      color: #777168;
      font-size: .85rem;
      line-height: 1.5;
    }

    .cms-callout {
      margin: 2em 0;
      padding: 20px 22px;
      border-left: 3px solid #C95F3C;
      background: #E9E1D1;
    }

    .cms-callout--important {
      border-left-color: var(--article-ink);
      background: #E3D9C7;
    }

    .cms-callout--warning {
      border-left-color: #B33A2D;
      background: #F0DCD4;
    }

    .cms-callout-title {
      display: block;
      margin-bottom: 8px;
    }

    .cms-callout p {
      margin: 0;
    }

    .cms-embed-frame {
      position: relative;
      aspect-ratio: 16 / 9;
      background: var(--article-ink);
    }

    .cms-embed-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .cms-cta {
      margin: 2.75em 0;
      padding: clamp(22px, 4vw, 38px);
      background: var(--article-ink);
      color: #F3EFE0;
    }

    .cms-cta h2 {
      margin: 12px 0;
      color: #F3EFE0;
    }

    .cms-cta p {
      color: #D5CEBF;
    }

    .cms-cta-eyebrow {
      color: #C95F3C;
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .cms-cta-button {
      display: inline-block;
      margin-top: 12px;
      padding: 11px 17px;
      background: #C95F3C;
      color: #fff !important;
      text-decoration: none !important;
    }

    .cms-code {
      margin: 2em 0;
      padding: 18px;
      overflow-x: auto;
      background: var(--article-ink);
      color: #F3EFE0;
      font-size: .88rem;
      line-height: 1.65;
      white-space: pre;
    }

    .cms-prose code {
      padding: 2px 5px;
      border-radius: 2px;
      background: #E7DFCE;
      font-size: .9em;
    }

    .cms-code code {
      padding: 0;
      background: none;
    }

    .cms-article-footer {
      max-width: 700px;
      margin: clamp(44px, 6vw, 60px) auto 0;
      padding-top: 20px;
      border-top: 1px solid var(--article-rule);
      color: #777168;
      font-size: 13px;
    }

    .cms-article-footer a {
      color: inherit;
      text-decoration: none;
    }

    @media (max-width: 640px) {
      .cms-article {
        padding: 32px 20px 72px;
      }

      .cms-breadcrumb {
        margin-bottom: 28px;
        font-size: 10px;
      }

      .cms-article-meta {
        gap: 8px 12px;
        margin-bottom: 13px;
        font-size: 9px;
      }

      .cms-article h1 {
        margin-bottom: 14px;
        font-size: clamp(1.85rem, 7.2vw, 2.45rem);
        line-height: 1.12;
        letter-spacing: -.04em;
      }

      .cms-article-excerpt {
        margin-bottom: 24px;
        font-size: 1rem;
        line-height: 1.6;
      }

      .cms-featured-image {
        width: 100%;
        max-height: 250px;
        margin-bottom: 34px;
      }

      .cms-prose {
        font-size: 1rem;
        line-height: 1.78;
      }

      .cms-prose h2 {
        margin-top: 2em;
        font-size: 1.5rem;
      }

      .cms-prose h3 {
        font-size: 1.2rem;
      }

      .cms-prose blockquote {
        padding-left: 17px;
      }

      .cms-code {
        margin-right: -2px;
        margin-left: -2px;
        padding: 14px;
        font-size: .82rem;
      }
    }
  

\n  </style>
</head>
<body class="blog-archive-page">
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="brand-lockup" href="{{ '/' | url }}" aria-label="Vevnit home"><span class="brand-wordmark">vevnit<span>.</span></span></a>
      <a class="mobile-nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
      <ul id="primary-menu">
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/blog/' | url }}">Blog</a></li>
        <li><a href="{{ '/case-studies/' | url }}">Work</a></li>
        <li><a class="nav-cta" href="mailto:makindegbenga00@gmail.com?subject=Vevnit%20project%20enquiry">Work with me</a></li>
      </ul>
    </nav>
  </header>
  <main class="cms-article">
    <article class="cms-article-inner">
      <nav class="cms-breadcrumb" aria-label="Breadcrumb"><a href="{{ '/' | url }}">Home</a> / <a href="{{ '/blog/' | url }}">Blog</a> / {{ title }}</nav>
      <div class="cms-article-meta"><span>{{ category or "Article" }}</span><time datetime="{{ page.date | date("%Y-%m-%d") }}">{{ page.date | date("%B %d, %Y") }}</time>{% if readTime %}<span>{{ readTime }}</span>{% endif %}<span>By {{ author or "Makinde" }}</span></div>
      <h1>{{ title }}</h1>
      <p class="cms-article-excerpt">{{ excerpt }}</p>
      {% if featuredImage %}<img class="cms-featured-image" src="{{ featuredImage }}" alt="{{ featuredImageAlt or (title + " featured image") }}" loading="lazy">{% endif %}
      <div class="cms-prose">{{ content | safe }}</div>
      {% include "article-cta.njk" %}
      <footer class="cms-article-footer"><a href="{{ '/blog/' | url }}">← Back to all articles</a></footer>
    </article>
  </main>
  <script src="/script.js?v=nav-fix-20261128"></script>
</body>
</html>
